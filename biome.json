{
    "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/*.js",
            "**/*.css",
            "!lit-core.min.js",
            "!morphdom-umd.js"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 72,
        "bracketSpacing": false
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "overrides": [
        {
            "includes": ["sf-theme.js"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useArrowFunction": "off"
                    },
                    "style": {
                        "useTemplate": "off"
                    },
                    "suspicious": {
                        "noRedundantUseStrict": "off",
                        "noDocumentCookie": "off"
                    }
                }
            }
        }
    ]
}
